# Copy this file to .env for local development.
# Never commit .env or real credentials.

TORI_ENV=development
TORI_LOG_LEVEL=INFO

# Market data / broker provider credentials
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
WEBULL_ACCESS_TOKEN=

# Optional read-only Alpaca market data adapter
ALPACA_API_KEY=
ALPACA_API_SECRET=

# Optional AI provider credentials
OPENAI_API_KEY=

# Optional public social research (separate from Webull).
# The social CLI reads process environment; it does not automatically load .env.
# Use approved Reddit OAuth access and an X developer app bearer token.
TORI_REDDIT_ACCESS_TOKEN=
TORI_X_BEARER_TOKEN=
